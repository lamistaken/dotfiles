{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.local.md"
  ],
  "provider": {
    "llm-gateway": {
      "models": {
        "glm-5.2": {
          "limit": {
            "context": 1000000,
            "output": 1000000
          }
        }
      }
    }
  },
  "lsp": true,
  "permission": {
    "external_directory": {
      "/tmp/**": "allow",
      "~/**": "allow"
    },
    "clipboard": "allow"
  },
  "agent": {
    "plan": {
      "permission": {
        "clipboard": "allow"
      }
    }
  }
}
